{
  "name": "PhotoMap Field",
  "short_name": "PhotoMap",
  "description": "Field companion for PhotoMap — share photos straight from your gallery and they land on the desktop map with their location intact.",
  "start_url": "./Photo-Map.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2F3F5",
  "theme_color": "#5865F2",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "photos", "accept": ["image/*", "application/octet-stream", ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".dng", ".gif", ".bmp"] } ]
    }
  }
}
